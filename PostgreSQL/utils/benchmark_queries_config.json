  "instructions": {
    "how_to_add_query": [
      "1. Aggiungi una nuova query nell'array 'test_queries'",
      "2. Usa un ID univoco progressivo (es: Q11, Q12, ...)",
      "3. Specifica il metodo: 'search', 'boolean', 'phrase', 'field'",
      "4. Imposta expected_min_results per validation",
      "5. Aggiungi relevant_docs per metriche IR",
      "6. Categorizza la query se necessario"
    ],
    "available_methods": {
      "search": "Ricerca full-text standard con ranking",
      "boolean": "Ricerca con operatori AND, OR, NOT",
      "phrase": "Ricerca frase esatta",
      "field": "Ricerca su campo specifico (title, content, label)"
    },
    "difficulty_levels": {
